{
  "schema_version": "0.1.0",
  "as_of": "2026-09-24",
  "purpose": "Detectar fatos planejados, publicados, contratados, licenciados e em execução antes que necessariamente apareçam fisicamente no mapa.",
  "privacy_rule": "Nunca descobrir/indexar processos por proprietário, CPF, CNPJ de pessoa vinculada, requerente ou outros identificadores pessoais. Correlacionar por geometria, endereço, identificador público do imóvel, número de processo já legitimamente conhecido ou referência documental.",
  "match_priority": [
    "OFFICIAL_GEOMETRY",
    "OFFICIAL_PROPERTY_IDENTIFIER",
    "OFFICIAL_ADDRESS",
    "SPATIAL_PROXIMITY",
    "DOCUMENT_REFERENCE",
    "TEXT_ONLY"
  ],
  "federal": [
    {
      "source_id": "br-obrasgov-api",
      "role": "PUBLIC_WORKS_PRIMARY",
      "ingest_mode": "OPEN_API",
      "event_types": [
        "PROJECT_PLANNED",
        "WORK_STARTED",
        "WORK_PAUSED",
        "WORK_RESUMED",
        "WORK_COMPLETED"
      ],
      "expected_fields": [
        "project_id",
        "name",
        "geometry",
        "status",
        "physical_progress",
        "financial_progress",
        "value",
        "authority",
        "dates"
      ],
      "notes": "Usar apenas a nova API pública ObrasGov; ambiente legado não deve ser novo alvo de integração."
    },
    {
      "source_id": "br-pncp-open-api",
      "role": "PROCUREMENT_CONTRACT_PRIMARY",
      "ingest_mode": "PUBLIC_GET_API",
      "event_types": [
        "PROCUREMENT_PUBLISHED",
        "CONTRACTED"
      ],
      "expected_fields": [
        "pncp_control_number",
        "authority",
        "object",
        "dates",
        "contract_ids",
        "document_urls"
      ],
      "notes": "Somente consultas GET públicas. APIs de inserção/retificação/exclusão ficam fora do LoteDiretor."
    },
    {
      "source_id": "br-sei-public-search",
      "role": "FEDERAL_PUBLIC_PROCESS_EVIDENCE",
      "ingest_mode": "QUERY_ONLY",
      "event_types": [
        "PROCESS_OPENED",
        "PROCESS_MOVEMENT"
      ],
      "expected_fields": [
        "process_number",
        "authority",
        "subject",
        "public_status",
        "document_urls"
      ],
      "notes": "Usar quando processo já é conhecido/relevante; não realizar descoberta por pessoa."
    }
  ],
