{
  "schema_version": "0.1.0",
  "as_of": "2026-09-24",
  "description": "Resolver inicial de concessionárias, operadores e fontes técnicas para as cinco cidades L3 prioritárias. O resolver identifica quem presta/regula o serviço e quais datasets podem apoiar contexto técnico; não transforma proximidade de rede em prova de disponibilidade no imóvel.",
  "rules": {
    "key": "municipality_ibge + service_type + territory",
    "service_types": [
      "electricity",
      "gas",
      "water_sewer",
      "telecom",
      "drainage",
      "public_lighting"
    ],
    "availability_semantics": [
      "PROVIDER_TERRITORY_ONLY: confirma quem atende/regula a área, não disponibilidade no lote.",
      "NETWORK_CONTEXT: rede/ativo próximo pode ser exibido como contexto, não como capacidade ou ligação confirmada.",
      "PARCEL_AVAILABILITY: somente quando houver consulta/documento oficial específico para o endereço/lote.",
      "SUBMUNICIPAL_REQUIRED: município sozinho não basta; resolver por bairro/polígono/endereço."
    ],
    "privacy": "Não armazenar dados de unidade consumidora, titular, contrato ou pessoa sem base/autorização específica. BDGD deve usar allowlist de ativos técnicos.",
    "temporal": "Guardar vigência do território de concessão e versão/data dos datasets; mudanças de concessão não podem sobrescrever silenciosamente o histórico."
  },
