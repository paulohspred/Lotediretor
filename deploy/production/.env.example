# ---- Hostnames (DNS A/AAAA records → this server) ----
APEX_HOST=lotediretor.com.br
SITE_HOST=www.lotediretor.com.br
APP_HOST=app.lotediretor.com.br
ADMIN_HOST=admin.lotediretor.com.br
AUTH_HOST=auth.lotediretor.com.br
ACME_EMAIL=infra@lotediretor.com.br
# Restrict the admin panel to office/VPN addresses (space-separated CIDRs).
ADMIN_ALLOWED_IPS=0.0.0.0/0 ::/0

# ---- Secrets: generate each with `openssl rand -base64 32` ----
POSTGRES_PASSWORD=
APP_DB_USER=sentinelx
APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=
CLIENT_SESSION_SECRET=
ADMIN_SESSION_SECRET=
LEAD_HASH_SALT=

# ---- OIDC client secrets (imported into Keycloak on first start; generate like above) ----
CLIENT_OIDC_SECRET=
ADMIN_OIDC_SECRET=

# ---- A.I Cidades (optional: without a key it runs in retrieval-only mode) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MAX_QUESTIONS_PER_HOUR=30

# ---- Company identity shown on legal pages (baked into the site at build) ----
COMPANY_NAME=
COMPANY_CNPJ=
COMPANY_ADDRESS=
DPO_EMAIL=
# Set to true only after the privacy policy and terms were reviewed by counsel.
LEGAL_REVIEWED=false

# Host directory with materialized city datasets used by the engine.
ENGINE_DATA_DIR=/srv/lotediretor/data

# Phase 6 raw national restriction snapshots (persistent host path)
RESTRICTION_SNAPSHOT_DIR=/srv/lotediretor/snapshots/restrictions
